atomic_write_patch_state() {
  local name="$1" value="$2" tmp="" path
  path="$STATE_DIR/$name"
  tmp="$(mktemp "$STATE_DIR/.patch-state.XXXXXX" 2>/dev/null)" || return 1
  if printf '%s\n' "$value" >"$tmp" && chmod 0600 "$tmp" && mv -f "$tmp" "$path"; then
    return 0
  fi
  rm -f "$tmp" 2>/dev/null || true
  return 1
}

# 输出已持续天数。只读模式不会创建、重置或删除状态。
# Print condition age in days. Read-only mode never creates, resets, or removes state.
tracked_patch_age() {
  local name="$1" active="$2" persist="$3" now="$4" first=0 path
  path="$STATE_DIR/$name"
  if [[ "$active" -ne 1 ]]; then
    if [[ "$persist" -eq 1 ]] && ! rm -f "$path" 2>/dev/null; then return 1; fi
    printf '0\n'; return 0
  fi
  if [[ -e "$path" ]]; then
    [[ -r "$path" ]] || return 1
    first="$(head -1 "$path" 2>/dev/null || true)"
    [[ "$first" =~ ^[1-9][0-9]*$ ]] || first=0
  fi
  if [[ "$first" -le 0 || "$first" -gt "$now" ]]; then
    first="$now"
    if [[ "$persist" -eq 1 ]] && ! atomic_write_patch_state "$name" "$first"; then return 1; fi
  fi
  printf '%s\n' "$(( (now - first) / 86400 ))"
}

apt_config_bool() {
  local dump="$1" key="$2" want="$3"
  printf '%s\n' "$dump" | awk -v key="$key" -v want="$want" '
    BEGIN { key=tolower(key); want=tolower(want) }
    {
      line=tolower($0)
      if (index(line, key " ") == 1) {
        value=substr(line, length(key)+2); sub(/[[:space:]]*;[[:space:]]*$/, "", value)
        gsub(/^[[:space:]\047\"]+|[[:space:]\047\"]+$/, "", value)
        if (value == want) found=1
      }
    }
    END { exit(found ? 0 : 1) }
  '
}

dnf_config_value() {
  local file="$1" wanted_section="$2" wanted_key="$3"
  awk -v wanted_section="$wanted_section" -v wanted_key="$wanted_key" '
    function trim(s) { sub(/^[[:space:]]+/, "", s); sub(/[[:space:]]+$/, "", s); return s }
    /^[[:space:]]*[#;]/ || /^[[:space:]]*$/ { next }
    /^[[:space:]]*\[/ {
      section=tolower($0); sub(/^[[:space:]]*\[/, "", section); sub(/\][[:space:]]*$/, "", section); section=trim(section); next
    }
    {
      pos=index($0, "="); if (!pos) next
      key=tolower(trim(substr($0, 1, pos-1))); value=tolower(trim(substr($0, pos+1)))
      sub(/[[:space:]]*[#;].*$/, "", value); value=trim(value)
      if (section == tolower(wanted_section) && key == tolower(wanted_key)) { print value; exit }
    }
  ' "$file" 2>/dev/null
}

inspect_apt_metadata() {
  local lists_dir="${SECURITY_UPDATE_NOTIFY_APT_LISTS_DIR:-/var/lib/apt/lists}" now="$1" stale="$2"
  local path name content valid deadline mtime latest_security=0 has_security=0 expired=0 is_security
  local -a paths=()
  shopt -s nullglob
  paths=("$lists_dir"/*InRelease)
  shopt -u nullglob
  if [[ ${#paths[@]} -eq 0 ]]; then
    patch_add_issue "apt-metadata-missing" "未发现已验证的 APT InRelease 元数据" "No verified APT InRelease metadata was found"
    return
  fi
  for path in "${paths[@]}"; do
    name="${path##*/}"; name="${name,,}"
    is_security=0
    if [[ "$name" == *security* || "$name" == *esm* ]]; then has_security=1; is_security=1; fi
    mtime="$(stat -c %Y "$path" 2>/dev/null || echo 0)"
    [[ "$is_security" -eq 1 && "$mtime" =~ ^[0-9]+$ && "$mtime" -gt "$latest_security" ]] && latest_security="$mtime"
    content="$(head -c 262144 "$path" 2>/dev/null || true)"
    valid="$(printf '%s\n' "$content" | sed -n 's/^[Vv][Aa][Ll][Ii][Dd]-[Uu][Nn][Tt][Ii][Ll]:[[:space:]]*//p' | head -1)"
    if [[ -n "$valid" ]]; then
      deadline="$(date -d "$valid" +%s 2>/dev/null || echo 0)"
      [[ "$deadline" =~ ^[0-9]+$ && "$deadline" -gt 0 && "$now" -gt "$deadline" ]] && expired=1
    fi
  done
  [[ "$has_security" -eq 1 ]] || patch_add_issue "apt-security-metadata-missing" "未发现安全更新源的 InRelease 元数据" "No InRelease metadata was found for a security-update source"
  [[ "$expired" -eq 0 ]] || patch_add_issue "apt-metadata-expired" "APT 软件源元数据已过有效期" "APT repository metadata has expired"
  if [[ "$stale" -gt 0 && "$latest_security" -gt 0 ]] && (( now - latest_security > stale * 86400 )); then
    patch_add_issue "apt-metadata-stale" "APT 软件源元数据已超过 $stale 天未刷新" "APT repository metadata has not been refreshed for more than $stale days"
  fi
}

collect_apt_patch_health() {
  local now="$1" held ignore_out ignore_rc apt_dump apt_rc audit audit_rc check_rc result journal
  local blocked="" pkg normal_pkg err_file
  if [[ "$PENDING_QUERY_RC" -ne 0 ]]; then
    patch_add_issue "apt-simulation-failed" "APT 无法计算待安装安全更新" "APT could not calculate pending security updates"
  fi

  held="$(patch_command apt-mark showhold 2>/dev/null || true)"
  err_file="$(mktemp "${TMPDIR:-/tmp}/sun-apt-ignore.XXXXXX")" || err_file=/dev/null
  if ignore_out="$(patch_command apt-get -s --ignore-hold upgrade 2>"$err_file")"; then ignore_rc=0; else ignore_rc=$?; fi
  [[ "$err_file" == /dev/null ]] || rm -f "$err_file"
  if [[ "$ignore_rc" -eq 0 ]]; then
    while IFS= read -r pkg; do
      [[ -n "$pkg" ]] || continue
      printf '%s\n' "$held" | sed 's/:.*//' | grep -Fxq "$pkg" || continue
      normal_pkg=0; printf '%s\n' "$PENDING_PACKAGES" | grep -Fxq "$pkg" && normal_pkg=1
      [[ "$normal_pkg" -eq 1 ]] || blocked+="$pkg"$'\n'
    done < <(printf '%s\n' "$ignore_out" | awk '/^Inst / && tolower($0) ~ /security/ {name=$2; sub(/:.*/, "", name); print name}' | sort -u)
  fi
  blocked="$(printf '%s' "$blocked" | sed '/^$/d' | sort -u)"
  [[ -z "$blocked" ]] || add_blocked_packages "$blocked"

  if apt_dump="$(patch_command apt-config dump 2>/dev/null)"; then apt_rc=0; else apt_rc=$?; fi
  if [[ "$apt_rc" -ne 0 ]]; then
    patch_add_issue "apt-config-unreadable" "无法读取 APT 有效配置" "Could not read the effective APT configuration"
  else
    if ! command -v systemctl >/dev/null 2>&1 || ! patch_command systemctl is-enabled apt-daily.timer >/dev/null 2>&1; then
      patch_add_issue "apt-daily-disabled" "APT 软件源刷新定时器未启用（apt-daily.timer）" "APT metadata refresh timer is not enabled (apt-daily.timer)"
    fi
    apt_config_bool "$apt_dump" "apt::periodic::update-package-lists" "1" || patch_add_issue "apt-periodic-update-disabled" "APT 每日软件源刷新策略未启用" "APT daily package-list refresh is not enabled"
    apt_config_bool "$apt_dump" "apt::periodic::unattended-upgrade" "1" || patch_add_issue "apt-unattended-disabled" "APT 自动安全更新策略未启用" "APT unattended security upgrades are not enabled"
    if ! printf '%s\n' "$apt_dump" | awk 'tolower($0) ~ /unattended-upgrade::(origins-pattern|allowed-origins)/ && tolower($0) ~ /(security|esm)/ {found=1} END {exit(found ? 0 : 1)}'; then
      patch_add_issue "apt-security-origin-missing" "APT unattended-upgrades 未发现安全更新源策略" "No security origin policy was found for APT unattended-upgrades"
    fi
    apt_config_bool "$apt_dump" "unattended-upgrade::automatic-reboot" "true" && patch_add_issue "apt-auto-reboot-enabled" "APT 被配置为自动重启，偏离 SUN 的人工维护策略" "APT is configured to reboot automatically, contrary to SUN's manual-maintenance policy"
  fi

  if audit="$(patch_command dpkg --audit 2>&1)"; then audit_rc=0; else audit_rc=$?; fi
  [[ "$audit_rc" -eq 0 && -z "${audit//[[:space:]]/}" ]] || patch_add_issue "dpkg-audit" "dpkg 报告未完成或损坏的软件包状态，请运行 dpkg --audit" "dpkg reports incomplete or broken package state; run dpkg --audit"
  patch_command apt-get check -qq >/dev/null 2>&1; check_rc=$?
  [[ "$check_rc" -eq 0 ]] || patch_add_issue "apt-check" "APT 依赖一致性检查失败，请运行 apt-get check" "APT dependency consistency check failed; run apt-get check"

  result="$(patch_command systemctl show apt-daily.service -p Result --value 2>/dev/null || true)"
  if [[ -n "$result" && "$result" != success ]]; then
    journal="$(patch_command journalctl -u apt-daily.service -n 100 --no-pager -o cat 2>&1 || true)"
    if repository_signature_error "$journal"; then
      patch_add_issue "apt-repository-signature" "APT 软件源元数据签名、有效期或 TLS 校验失败" "APT repository metadata signature, expiry, or TLS verification failed"
    else
      patch_add_issue "apt-daily-failed" "上次 APT 软件源刷新失败（apt-daily.service）" "The last APT metadata refresh failed (apt-daily.service)"
    fi
  fi
  inspect_apt_metadata "$now" "$STALE_UPDATE_DAYS"
}

collect_dnf_patch_health() {
  local unrestricted unrestricted_rc blocked="" pkg config_file value check_rc err_file
  if [[ "$PENDING_QUERY_RC" -ne 0 ]]; then
    if repository_signature_error "$PENDING_QUERY_ERR"; then
      patch_add_issue "dnf-repository-signature" "DNF 软件源元数据签名或 TLS 校验失败" "DNF repository metadata signature or TLS verification failed"
    else
      patch_add_issue "dnf-repository-failed" "DNF 无法读取安全更新元数据" "DNF could not read security-update metadata"
    fi
  fi
  err_file="$(mktemp "${TMPDIR:-/tmp}/sun-dnf-unrestricted.XXXXXX")" || err_file=/dev/null
  if unrestricted="$(patch_command dnf -q --disableplugin=versionlock --disableexcludes=all updateinfo list security 2>"$err_file")"; then unrestricted_rc=0; else unrestricted_rc=$?; fi
  [[ "$err_file" == /dev/null ]] || rm -f "$err_file"
  if [[ "$unrestricted_rc" -eq 0 ]]; then
    while IFS= read -r pkg; do
      [[ -n "$pkg" ]] || continue
      printf '%s\n' "$PENDING_PACKAGES" | grep -Fxq "$pkg" || blocked+="$pkg"$'\n'
    done < <(printf '%s\n' "$unrestricted" | awk '$NF ~ /\.(x86_64|noarch|aarch64|i686|ppc64le|s390x)$/ {print $NF}' | sort -u)
  fi
  blocked="$(printf '%s' "$blocked" | sed '/^$/d' | sort -u)"
  [[ -z "$blocked" ]] || add_blocked_packages "$blocked"

  config_file="${SECURITY_UPDATE_NOTIFY_DNF_AUTOMATIC_CONF:-/etc/dnf/automatic.conf}"
  if [[ ! -r "$config_file" ]]; then
    patch_add_issue "dnf-automatic-config" "无法读取 /etc/dnf/automatic.conf" "Could not read /etc/dnf/automatic.conf"
  else
    value="$(dnf_config_value "$config_file" commands upgrade_type)"
    [[ "$value" == security ]] || patch_add_issue "dnf-upgrade-type-drift" "dnf-automatic 未配置为只安装安全更新" "dnf-automatic is not configured for security-only updates"
    value="$(dnf_config_value "$config_file" commands apply_updates)"
    [[ "$value" == yes ]] || patch_add_issue "dnf-apply-updates-disabled" "dnf-automatic 未启用自动应用更新" "dnf-automatic is not configured to apply updates"
  fi
  patch_command dnf -q check >/dev/null 2>&1; check_rc=$?
  [[ "$check_rc" -eq 0 ]] || patch_add_issue "dnf-check" "DNF 软件包一致性检查失败，请运行 dnf check" "DNF package consistency check failed; run dnf check"
}

add_blocked_packages() {
  local blocked="$1" reason summary count
  reason="$(stable_patch_reason blocked-packages "$blocked")"
  PATCH_REASON_CODES+=("$reason")
  PATCH_RISK_ATTENTION=1
  count="$(printf '%s\n' "$blocked" | sed '/^$/d' | wc -l | tr -d ' ')"
  summary="$(printf '%s\n' "$blocked" | sed '/^$/d' | sed -n '1,8p' | awk 'BEGIN{first=1} {if (!first) printf ", "; printf "%s", $0; first=0}')"
  [[ "$count" -le 8 ]] || summary+=" ... (+$((count - 8)))"
  PATCH_TXT_ZH+="• 安全更新被 hold、versionlock 或 exclude 阻止：$summary"$'\n'
  PATCH_TXT_EN+="• Security updates are blocked by hold, versionlock, or exclude: $summary"$'\n'
}

collect_periodic_self_update() {
  [[ "$CHECK_SELF_UPDATE" -eq 1 && -n "$VERSION" ]] || return 0
  if [[ "$DOCTOR" -eq 0 && ( "$TEST_REBOOT" -eq 1 || "$SEND_OK" -eq 1 ) ]]; then return 0; fi
  local now="$1" persist="$2" checked=0 due=0 path latest rc
  path="$STATE_DIR/self-update.checked_at"
  if [[ -e "$path" ]]; then
    if [[ ! -r "$path" ]]; then patch_add_issue "patch-state-write" "无法持久化补丁状态时长，请检查 /var/lib/security-update-notify" "Could not persist patch-state age; inspect /var/lib/security-update-notify"; return; fi
    checked="$(head -1 "$path" 2>/dev/null || echo 0)"; [[ "$checked" =~ ^[1-9][0-9]*$ ]] || checked=0
  fi
  path="$STATE_DIR/self-update.latest"
  if [[ -e "$path" ]]; then
    if [[ ! -r "$path" ]]; then patch_add_issue "patch-state-write" "无法持久化补丁状态时长，请检查 /var/lib/security-update-notify" "Could not persist patch-state age; inspect /var/lib/security-update-notify"; return; fi
    LATEST_VERSION="$(head -1 "$path" 2>/dev/null || true)"
  fi
  [[ "$DOCTOR" -eq 1 || "$checked" -le 0 || "$checked" -gt "$now" ]] && due=1
  (( now - checked >= SELF_UPDATE_CHECK_DAYS * 86400 )) && due=1
  if [[ "$due" -eq 1 ]]; then
    LATEST_VERSION=""
    if latest="$(latest_release_version)"; then
      LATEST_VERSION="$latest"
      if [[ "$persist" -eq 1 ]]; then
        atomic_write_patch_state self-update.latest "$LATEST_VERSION" \
          && atomic_write_patch_state self-update.checked_at "$now" \
          || patch_add_issue "patch-state-write" "无法持久化补丁状态时长，请检查 /var/lib/security-update-notify" "Could not persist patch-state age; inspect /var/lib/security-update-notify"
      fi
    else
      rc=$?; SELF_UPDATE_CHECK_ERR=1
      log_event "self-update check failed rc=$rc host=$HOST"
    fi
  fi
  if is_newer_version "$VERSION" "$LATEST_VERSION"; then
    UPDATE_AVAILABLE=1
    PATCH_REASON_CODES+=("$(stable_patch_reason sun-update "$LATEST_VERSION")")
    UPDATE_TXT_ZH="SUN 新版本可用：$VERSION -> $LATEST_VERSION。请手动运行 sudo security-update-notify --upgrade。"
    UPDATE_TXT_EN="A new SUN version is available: $VERSION -> $LATEST_VERSION. Run sudo security-update-notify --upgrade manually."
  fi
}

collect_patch_watchdog() {
  local now persist=1 age
  now="$(date +%s)"
  [[ "$DOCTOR" -eq 0 && "$TEST_REBOOT" -eq 0 && "$SEND_OK" -eq 0 ]] || persist=0
  collect_security_updates
  if [[ "$CHECK_UPDATE_HEALTH" -eq 1 ]]; then
    case "$BACKEND" in
      apt) collect_apt_patch_health "$now" ;;
      dnf) collect_dnf_patch_health ;;
    esac
  fi

  if ! age="$(tracked_patch_age pending-security.first_seen "$([[ "$PENDING_SEC_COUNT" -gt 0 ]] && echo 1 || echo 0)" "$persist" "$now")"; then
    patch_add_issue "patch-state-write" "无法持久化补丁状态时长，请检查 /var/lib/security-update-notify" "Could not persist patch-state age; inspect /var/lib/security-update-notify"; age=0
  fi
  if [[ "$PENDING_SEC_COUNT" -gt 0 && "$PENDING_ALERT_DAYS" -gt 0 && "$age" -ge "$PENDING_ALERT_DAYS" ]]; then
    patch_add_issue "pending-stale" "待安装安全更新已连续存在 $age 天（阈值 $PENDING_ALERT_DAYS 天）" "Pending security updates have remained for $age days (threshold $PENDING_ALERT_DAYS days)"
  fi
  if ! age="$(tracked_patch_age reboot-required.first_seen "$reboot_required" "$persist" "$now")"; then
    patch_add_issue "patch-state-write" "无法持久化补丁状态时长，请检查 /var/lib/security-update-notify" "Could not persist patch-state age; inspect /var/lib/security-update-notify"; age=0
  fi
  if [[ "$RESTART_ALERT_DAYS" -gt 0 && "$age" -ge "$RESTART_ALERT_DAYS" ]]; then
    patch_add_issue "reboot-stale" "整机重启需求已持续 $age 天（阈值 $RESTART_ALERT_DAYS 天）" "The full-reboot requirement has remained for $age days (threshold $RESTART_ALERT_DAYS days)"
  fi
  if ! age="$(tracked_patch_age service-restart.first_seen "$restart_attention" "$persist" "$now")"; then
    patch_add_issue "patch-state-write" "无法持久化补丁状态时长，请检查 /var/lib/security-update-notify" "Could not persist patch-state age; inspect /var/lib/security-update-notify"; age=0
  fi
  if [[ "$RESTART_ALERT_DAYS" -gt 0 && "$age" -ge "$RESTART_ALERT_DAYS" ]]; then
    patch_add_issue "service-restart-stale" "服务重启需求已持续 $age 天（阈值 $RESTART_ALERT_DAYS 天）" "Service restart requirements have remained for $age days (threshold $RESTART_ALERT_DAYS days)"
  fi
  collect_periodic_self_update "$now" "$persist"

  PATCH_TXT_ZH="${PATCH_TXT_ZH%$'\n'}"; PATCH_TXT_EN="${PATCH_TXT_EN%$'\n'}"
  if [[ ${#PATCH_REASON_CODES[@]} -gt 0 ]]; then
    PATCH_SIG="$(printf '%s\n' "${PATCH_REASON_CODES[@]}" | sed '/^$/d' | sort -u | tr '\n' ',')"
  fi
  AUTO_HEALTH_ATTENTION="$HEALTH_ATTENTION"
  HEALTH_SIG="$(printf '%s,%s' "$HEALTH_SIG" "$PATCH_SIG" | tr ',' '\n' | sed '/^$/d' | sort -u | tr '\n' ',')"
  if [[ "$PATCH_RISK_ATTENTION" -eq 1 || "$UPDATE_AVAILABLE" -eq 1 ]]; then HEALTH_ATTENTION=1; fi
}

# 各发行版“安全支持终止”近似日期（best-effort，需随时间维护；Fedora 生命周期短，故意不列）。
# Approximate security end-of-life per release (best-effort; maintain over time; Fedora intentionally omitted).
eol_date_for() {
  local id="$1" ver="$2" pretty="${3:-}" major="${2%%.*}"
  case "$id" in
    debian) case "$ver" in 11) echo 2026-08-31 ;; 12) echo 2028-06-30 ;; 13) echo 2030-06-30 ;; esac ;;
    ubuntu) case "$ver" in 20.04) echo 2025-05-31 ;; 22.04) echo 2027-06-01 ;; 24.04) echo 2029-05-31 ;; esac ;;
    rhel|rocky|ol|cloudlinux) case "$major" in 8) echo 2029-05-31 ;; 9) echo 2032-05-31 ;; 10) echo 2035-05-31 ;; esac ;;
    almalinux) case "$major" in 8) echo 2029-03-01 ;; 9) echo 2032-05-31 ;; 10) echo 2035-05-31 ;; esac ;;
    centos)
      if [[ "$pretty" == *"Stream"* ]]; then
        case "$major" in 8) echo 2024-05-31 ;; 9) echo 2027-05-31 ;; esac
      else
        case "$major" in 7) echo 2024-06-30 ;; 8) echo 2021-12-31 ;; esac
      fi
      ;;
    amzn) case "$ver" in 2023) echo 2029-06-30 ;; esac ;;
  esac
}

# 发行版安全支持即将/已经终止时告警（已过 EOL=触发告警；临近=仅信息，避免提前数月反复打扰）。
# Warn when distro security support is ending/ended (past EOL triggers an alert; approaching is informational).
check_eol() {
  [[ "${CHECK_EOL:-1}" == "1" ]] || return 0
  local eol now eol_epoch days warn_days=90
  eol="$(eol_date_for "${OS_RELEASE_ID:-}" "${OS_RELEASE_VERSION_ID:-}" "${OS_RELEASE_PRETTY_NAME:-}")"
  [[ -n "$eol" ]] || return 0
  now="$(date +%s)"
  eol_epoch="$(date -d "$eol" +%s 2>/dev/null || echo 0)"
  [[ "$eol_epoch" =~ ^[0-9]+$ && "$eol_epoch" -gt 0 ]] || return 0
  if (( now > eol_epoch )); then
    EOL_ATTENTION=1; EOL_SIG="past"
    EOL_TXT_ZH="⛔ 本系统的安全支持已于 $eol 终止，将不再收到安全更新，请尽快规划升级发行版。"
    EOL_TXT_EN="⛔ Security support for this release ended on $eol; it no longer receives security updates. Plan a distro upgrade."
  elif (( eol_epoch - now < warn_days * 86400 )); then
    days=$(( (eol_epoch - now) / 86400 ))
    EOL_SIG="soon"
    EOL_TXT_ZH="⚠️ 本系统的安全支持将于 $eol 终止（约剩 $days 天），请规划升级。"
    EOL_TXT_EN="⚠️ Security support for this release ends on $eol (~$days days left). Plan an upgrade."
  fi
}

run_doctor() {
  local ok=1
  echo "security-update-notify $VERSION"
  say "配置文件: $ENV_FILE" "Config: $ENV_FILE"
  [[ -r "$ENV_FILE" ]] && say "正常：配置可读" "OK config readable" || { say "失败：配置不可读" "FAIL config not readable"; ok=0; }
  say "后端: $BACKEND" "Backend: $BACKEND"
  say "通知渠道: $NOTIFY_CHANNELS" "Notification channels: $NOTIFY_CHANNELS"
  say "主机: $HOST" "Host: $HOST"
  [[ "$INCLUDE_PUBLIC_IP" -eq 1 ]] && say "公网 IP: $PUBLIC_IP_VALUE" "Public IP: $PUBLIC_IP_VALUE"
  say "系统: $OS" "OS: $OS"
  say "内核: $KERNEL" "Kernel: $KERNEL"
  if [[ -d /run/systemd/system ]] && command -v systemctl >/dev/null 2>&1; then
    say "正常：systemd 存在" "OK systemd present"
    systemctl is-enabled security-update-notify.timer >/dev/null 2>&1 && say "正常：timer 已启用" "OK timer enabled" || { say "警告：timer 未启用" "WARN timer not enabled"; ok=0; }
    systemctl list-timers security-update-notify.timer --no-pager 2>/dev/null || true
  else
    say "失败：systemd 不可用" "FAIL systemd unavailable"; ok=0
  fi
  case "$BACKEND" in
    apt)
      for c in apt-get dpkg needrestart; do command -v "$c" >/dev/null 2>&1 && say "正常：命令存在 $c" "OK command $c" || { say "失败：缺少命令 $c" "FAIL missing command $c"; ok=0; }; done
      dpkg -s unattended-upgrades >/dev/null 2>&1 && say "正常：unattended-upgrades 已安装" "OK unattended-upgrades installed" || { say "失败：缺少 unattended-upgrades" "FAIL unattended-upgrades missing"; ok=0; }
      ;;
    dnf)
      if command -v dnf >/dev/null 2>&1; then say "正常：命令存在 dnf" "OK command dnf"
      elif command -v yum >/dev/null 2>&1; then say "正常：命令存在 yum" "OK command yum"
      else say "失败：缺少 dnf/yum" "FAIL missing dnf/yum"; ok=0; fi
      command -v needs-restarting >/dev/null 2>&1 && say "正常：命令存在 needs-restarting" "OK command needs-restarting" || { say "失败：缺少 needs-restarting" "FAIL missing needs-restarting"; ok=0; }
      systemctl is-enabled dnf-automatic.timer >/dev/null 2>&1 && say "正常：dnf-automatic.timer 已启用" "OK dnf-automatic.timer enabled" || say "警告：dnf-automatic.timer 未启用" "WARN dnf-automatic.timer not enabled"
      ;;
    *) say "失败：不支持的后端 $BACKEND" "FAIL unsupported backend $BACKEND"; ok=0 ;;
  esac
  if [[ "$DOCTOR_SKIP_NOTIFY" -eq 1 ]]; then
    say "跳过：通知渠道联通性检查" "SKIP notification connectivity checks"
  else
    if channel_selected telegram && [[ "$DOCTOR_SKIP_TELEGRAM" -eq 1 ]]; then
      say "跳过：Telegram 联通性检查" "SKIP Telegram connectivity check"
    elif channel_selected telegram; then
      if [[ -n "${TELEGRAM_BOT_TOKEN:-}" && -n "${TELEGRAM_CHAT_ID:-}" ]]; then
        say "正常：Telegram 配置存在" "OK Telegram config present"
        if telegram_get_me >/dev/null; then
          say "正常：Telegram Bot Token 可用" "OK Telegram bot token works"
        else
          say "失败：Telegram getMe 失败" "FAIL Telegram getMe failed"; ok=0
        fi
      else
        say "失败：Telegram 配置缺失" "FAIL Telegram config missing"; ok=0
      fi
    fi
    if channel_selected feishu && [[ "$DOCTOR_SKIP_FEISHU" -eq 1 ]]; then
      say "跳过：飞书联通性检查" "SKIP Feishu connectivity check"
    elif channel_selected feishu; then
      if channel_configured feishu; then
        say "正常：飞书配置和凭据存在" "OK Feishu config and credential present"
        if feishu_get_token >/dev/null; then
          say "正常：飞书 App Secret 可用" "OK Feishu App Secret works"
        else
          say "失败：飞书 token 获取失败" "FAIL Feishu token request failed"; ok=0
        fi
      else
        say "失败：飞书配置或凭据缺失" "FAIL Feishu config or credential missing"; ok=0
      fi
    fi
  fi
  # 检测结果已在进入 doctor 前统一采集；doctor 只读展示，不改写时长或版本缓存状态。
  # Results were collected before doctor; doctor only renders them and never mutates age/version state.
  if [[ "$AUTO_HEALTH_ATTENTION" -eq 1 ]]; then
    say "失败：自动安全更新机制异常" "FAIL automatic security-update mechanism issue"; ok=0
    say "$HEALTH_TXT_ZH" "$HEALTH_TXT_EN"
  else
    say "正常：自动安全更新机制健康" "OK automatic security-update mechanism healthy"
  fi
  if [[ "$PATCH_RISK_ATTENTION" -eq 1 ]]; then
    say "失败：补丁维护检查发现风险" "FAIL patch-maintenance checks found risks"; ok=0
    say "$PATCH_TXT_ZH" "$PATCH_TXT_EN"
  else
    say "正常：补丁策略、软件包和仓库检查通过" "OK patch policy, package, and repository checks passed"
  fi
  if [[ "$SELF_UPDATE_CHECK_ERR" -eq 1 ]]; then
    say "失败：无法检查 SUN 最新版本" "FAIL could not check the latest SUN version"; ok=0
  elif [[ "$UPDATE_AVAILABLE" -eq 1 ]]; then
    say "$UPDATE_TXT_ZH" "$UPDATE_TXT_EN"
  elif [[ -n "$LATEST_VERSION" ]]; then
    say "正常：SUN 已是最新版本（$VERSION）" "OK SUN is up to date ($VERSION)"
  fi
  if [[ "$PENDING_SEC_COUNT" -gt 0 ]]; then
    say "$PENDING_TXT_ZH" "$PENDING_TXT_EN"
  else
    say "正常：当前无待安装的安全更新" "OK no pending security updates"
  fi
  if [[ -n "$EOL_TXT_ZH" ]]; then
    [[ "$EOL_ATTENTION" -eq 1 ]] && ok=0
    say "$EOL_TXT_ZH" "$EOL_TXT_EN"
  else
    say "正常：发行版仍在安全支持期内（或不在 EOL 表中）" "OK release within security support (or not in the EOL table)"
  fi
  [[ "$ok" -eq 1 ]] || return 1
}

