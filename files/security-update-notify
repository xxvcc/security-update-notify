feishu_get_token() {
  { printf '%s\0' "${FEISHU_APP_ID:-}"; feishu_secret_to_stdout; } | python3 -c '
import datetime, email.utils, json, os, sys, time, urllib.error, urllib.request

def retry_delay(headers):
    raw = (headers.get("Retry-After") or "").strip()
    try:
        return min(max(int(raw), 0), 30)
    except (TypeError, ValueError):
        pass
    try:
        when = email.utils.parsedate_to_datetime(raw)
        if when.tzinfo is None:
            when = when.replace(tzinfo=datetime.timezone.utc)
        now = datetime.datetime.now(datetime.timezone.utc)
        return min(max((when - now).total_seconds(), 0), 30)
    except (TypeError, ValueError, OverflowError):
        return 1

parts = sys.stdin.buffer.read().split(b"\0", 1)
app_id = parts[0].decode("utf-8", "replace") if parts else ""
secret = parts[1].decode("utf-8", "replace") if len(parts) > 1 else ""
if not app_id or not secret:
    print("缺少飞书 App ID 或 App Secret / missing Feishu App ID or App Secret", file=sys.stderr)
    sys.exit(2)
payload = json.dumps({"app_id": app_id, "app_secret": secret}).encode()
base_url = os.environ.get("SECURITY_UPDATE_NOTIFY_FEISHU_BASE_URL", "https://open.feishu.cn").rstrip("/")
for attempt in range(3):
    delay = 1
    req = urllib.request.Request(base_url + "/open-apis/auth/v3/tenant_access_token/internal", data=payload, headers={"Content-Type": "application/json; charset=utf-8"}, method="POST")
    try:
        with urllib.request.urlopen(req, timeout=30) as response:
            body = response.read(1048577)
        if len(body) > 1048576:
            raise ValueError("response too large")
        data = json.loads(body)
        if data.get("code") == 0 and data.get("tenant_access_token"):
            print(data["tenant_access_token"], end="")
            sys.exit(0)
        print(f"Feishu token failed: code={data.get('"'"'code'"'"')}", file=sys.stderr)
        sys.exit(1)
    except urllib.error.HTTPError as exc:
        if exc.code not in (429, 500, 502, 503, 504):
            print(f"Feishu token HTTP {exc.code}", file=sys.stderr)
            sys.exit(1)
        delay = retry_delay(exc.headers)
    except Exception:
        if attempt == 2:
            print("Feishu token request failed", file=sys.stderr)
            sys.exit(1)
    if attempt < 2:
        time.sleep(delay)
sys.exit(1)
'
}

feishu_build_card() {
  printf '%s\0' "$@" | python3 /dev/fd/3 3<<'PY'
import json
import sys

parts = sys.stdin.buffer.read().split(b"\0")
if parts and parts[-1] == b"":
    parts.pop()
if len(parts) != 34:
    print("invalid Feishu card input", file=sys.stderr)
    sys.exit(1)
values = [part.decode("utf-8", "replace") for part in parts]
(kind, lang, version, alert, host, include_ip, public_ip, os_name, backend, kernel, now,
 reboot, restart_attention, health_attention, patch_attention, update_available,
 pending_count, eol_attention, packages, restart_zh, restart_en, health_zh, health_en,
 patch_zh, patch_en, update_zh, update_en, pending_zh, pending_en, eol_zh, eol_en,
 fallback, from_version, to_version) = values
en = lang == "en"

def pick(zh, english):
    return english if en else zh

def clean(text):
    text = text.replace("\r\n", "\n").replace("\r", "\n")
    return "".join(ch for ch in text if ch in "\n\t" or (ord(ch) >= 0x20 and ord(ch) != 0x7f)).strip()

def limited(text, maximum):
    text = clean(text)
    raw = text.encode("utf-8")
    if len(raw) <= maximum:
        return text
    suffix = pick("\n…（内容已截断）", "\n...(truncated)").encode("utf-8")
    cut = raw[:max(maximum - len(suffix), 0)]
    while cut:
        try:
            prefix = cut.decode("utf-8")
            break
        except UnicodeDecodeError:
            cut = cut[:-1]
    else:
        prefix = ""
    return prefix.strip() + suffix.decode("utf-8")

def text_tag(text, color):
    return {"tag": "text_tag", "text": {"tag": "plain_text", "content": text}, "color": color}

def div(content, size="normal", color="default"):
    return {"tag": "div", "text": {"tag": "plain_text", "content": content,
                                      "text_size": size, "text_color": color}}

def cell(label, value, color="default"):
    return {"tag": "column", "width": "weighted", "weight": 1,
            "background_style": "grey", "padding": "8px", "vertical_spacing": "4px",
            "elements": [div(label, "normal", "grey"), div(value, "heading", color)]}

def grid(*cells):
    return {"tag": "column_set", "flex_mode": "bisect", "horizontal_spacing": "8px",
            "columns": list(cells)}

def divider():
    return {"tag": "hr"}

def callout(content, color):
    return {"tag": "column_set", "flex_mode": "stretch", "columns": [
        {"tag": "column", "width": "weighted", "weight": 1, "background_style": color,
         "padding": "10px", "elements": [div(content)]}
    ]}

def docs_button():
    return {"tag": "button",
            "text": {"tag": "plain_text", "content": pick("查看 SUN 使用说明", "View SUN documentation")},
            "type": "default", "width": "default", "size": "medium",
            "behaviors": [{"type": "open_url", "default_url": "https://github.com/xxvcc/security-update-notify"}]}

def section(elements, title, content, maximum):
    content = limited(content, maximum)
    if content:
        elements.extend([divider(), div(title, "heading"), div(content)])

def make_doc(title, subtitle, theme, summary, tags, elements):
    return {"schema": "2.0",
            "config": {"summary": {"content": limited(summary, 240)}, "enable_forward": False,
                       "update_multi": True, "width_mode": "fill"},
            "header": {"title": {"tag": "plain_text", "content": title},
                       "subtitle": {"tag": "plain_text", "content": limited(subtitle, 160)},
                       "text_tag_list": tags, "template": theme, "padding": "12px 12px 12px 12px"},
            "body": {"direction": "vertical", "padding": "12px 12px 12px 12px",
                     "vertical_spacing": "12px", "elements": elements}}

def encode_doc(doc):
    encoded = json.dumps(doc, ensure_ascii=False, separators=(",", ":"))
    if len(encoded.encode("utf-8")) <= 20 * 1024:
        return encoded
    doc["body"] = {"direction": "vertical", "padding": "12px 12px 12px 12px",
                   "vertical_spacing": "12px",
                   "elements": [div(limited(fallback, 8000)), docs_button()]}
    return json.dumps(doc, ensure_ascii=False, separators=(",", ":"))

if kind == "upgrade":
    title = pick("SUN 已升级", "SUN upgraded")
    version_change = limited(from_version + " → " + to_version, 256)
    tags = [text_tag("SUN", "blue"), text_tag(version_change, "green")]
    second_label, second_value = pick("版本", "Version"), version_change
    if include_ip == "1":
        second_label, second_value = pick("公网 IP", "Public IP"), limited(public_ip, 256)
    elements = [grid(cell(pick("主机", "Host"), limited(host, 512)),
                     cell(second_label, second_value))]
    if include_ip == "1":
        elements.append(grid(cell(pick("升级前", "Previous version"), limited(from_version, 128)),
                             cell(pick("当前版本", "Current version"), limited(to_version, 128), "green")))
    elements.extend([callout(pick("升级后自检已完成。", "Post-upgrade self-check completed."), "green"),
                     docs_button()])
    doc = make_doc(title, now, "blue", title + " · " + host + " · " + version_change, tags, elements)
    print(encode_doc(doc), end="")
    sys.exit(0)

is_alert = alert == "1"
has_health_problem = health_attention == "1"
has_patch_problem = patch_attention == "1"
has_update = update_available == "1"
has_eol_problem = eol_attention == "1"
if not is_alert:
    title, theme = pick("安全更新检查正常", "Security update check OK"), "green"
elif has_eol_problem:
    title, theme = pick("发行版安全支持已结束", "Distribution security support ended"), "red"
elif has_health_problem:
    title, theme = pick("自动安全更新机制异常", "Automatic security updates need attention"), "red"
elif has_patch_problem:
    title, theme = pick("补丁维护风险", "Patch maintenance risk"), "red"
elif has_update:
    title, theme = pick("SUN 新版本可用", "SUN update available"), "blue"
else:
    title, theme = pick("主机需要安全维护", "Host maintenance required"), "orange"

tags = [text_tag("SUN", "blue")]
if version.strip():
    tags.append(text_tag(limited("v" + version.lstrip("v"), 64), "neutral"))
if int(pending_count or "0") > 0 and len(tags) < 3:
    tags.append(text_tag(pick("待装 %s" % pending_count, "%s pending" % pending_count), "orange"))
elif backend.strip() and len(tags) < 3:
    tags.append(text_tag(limited(backend.upper(), 24), "neutral"))

second_label, second_value = pick("后端", "Backend"), backend
if include_ip == "1":
    second_label, second_value = pick("公网 IP", "Public IP"), public_ip

def yes_color(flag, problem_color):
    return problem_color if flag == "1" else "green"

support_text, support_color = pick("正常", "Supported"), "green"
eol_text = eol_en if en else eol_zh
if has_eol_problem:
    support_text, support_color = pick("已结束", "Ended"), "red"
elif eol_text.strip():
    support_text, support_color = pick("即将结束", "Ending soon"), "orange"

elements = [
    grid(cell(pick("主机", "Host"), limited(host, 512)),
         cell(second_label, limited(second_value, 256))),
    grid(cell(pick("系统", "OS"), limited(os_name, 768)),
         cell(pick("当前内核", "Current kernel"), limited(kernel, 256))),
    divider(),
    grid(cell(pick("整机重启", "Full reboot"),
              pick("需要", "Required") if reboot == "1" else pick("暂不需要", "Not required"),
              yes_color(reboot, "red")),
         cell(pick("服务/进程重启", "Service/process restart"),
              pick("需要处理", "Action needed") if restart_attention == "1" else pick("正常", "Normal"),
              yes_color(restart_attention, "orange"))),
    grid(cell(pick("补丁健康", "Patch health"),
              pick("异常", "Problem") if has_health_problem or has_patch_problem else pick("正常", "Healthy"),
              "red" if has_health_problem or has_patch_problem else "green"),
         cell(pick("安全支持", "Security support"), support_text, support_color))
]

if is_alert:
    package_text = packages if packages.strip() else pick("无", "None")
    section(elements, pick("相关包 / 安全更新", "Related packages / security updates"), package_text, 2500)
    section(elements, pick("维护详情", "Maintenance details"),
            restart_en if en else restart_zh, 4500)
else:
    elements.append(callout(pick("未发现整机重启或服务、进程重启需要关注的问题。",
                                  "No reboot or service/process restart requiring attention was detected."), "green"))

section(elements, pick("自动安全更新机制", "Automatic security-update mechanism"),
        health_en if en else health_zh, 2000)
section(elements, pick("补丁维护风险", "Patch maintenance risk"),
        patch_en if en else patch_zh, 3000)
if has_update:
    section(elements, pick("SUN 新版本", "SUN update available"),
            update_en if en else update_zh, 1500)
section(elements, pick("待安装安全更新", "Pending security updates"),
        pending_en if en else pending_zh, 2000)
section(elements, pick("发行版支持状态", "Distribution support status"), eol_text, 1500)
if is_alert:
    elements.append(callout(pick(
        "请在维护窗口 SSH 登录服务器进行处理。需要整机重启时执行 sudo reboot；仅涉及服务时，请先评估再重启对应服务。",
        "Handle this during a maintenance window over SSH. Run sudo reboot when a full reboot is required; otherwise review and restart only the affected services."), "grey"))
elements.append(docs_button())
doc = make_doc(title, now, theme, title + " · " + host, tags, elements)
print(encode_doc(doc), end="")
PY
}

