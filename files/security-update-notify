feishu_send_message() {
  local text="$1" card="${2:-}" token
  token="$(feishu_get_token)" || return $?
  printf '%s\0%s\0%s\0%s' "$token" "${FEISHU_RECEIVE_ID:-}" "$text" "$card" | python3 -c '
import datetime, email.utils, json, os, re, sys, time, urllib.error, urllib.request

def retry_delay(headers):
    raw = (headers.get("Retry-After") or "").strip()
    try:
        return min(max(int(raw), 0), 30)
    except (TypeError, ValueError):
        pass
    try:
        when = email.utils.parsedate_to_datetime(raw)
        if when.tzinfo is None:
            when = when.replace(tzinfo=datetime.timezone.utc)
        now = datetime.datetime.now(datetime.timezone.utc)
        return min(max((when - now).total_seconds(), 0), 30)
    except (TypeError, ValueError, OverflowError):
        return 1

parts = sys.stdin.buffer.read().split(b"\0", 3)
token = parts[0].decode("utf-8", "replace") if parts else ""
receive_id = parts[1].decode("utf-8", "replace") if len(parts) > 1 else ""
text = parts[2].decode("utf-8", "replace") if len(parts) > 2 else ""
card = parts[3].decode("utf-8", "replace") if len(parts) > 3 else ""
if not token or not receive_id:
    print("缺少飞书 token 或 open_id / missing Feishu token or open_id", file=sys.stderr)
    sys.exit(2)
if re.fullmatch(r"ou_[A-Za-z0-9_-]+", receive_id) is None:
    print("飞书接收人必须是 open_id / Feishu recipient must be an open_id", file=sys.stderr)
    sys.exit(2)
if len(text) > 20000:
    text = text[:19900] + "\n…(truncated)"
base_url = os.environ.get("SECURITY_UPDATE_NOTIFY_FEISHU_BASE_URL", "https://open.feishu.cn").rstrip("/")
url = base_url + "/open-apis/im/v1/messages?receive_id_type=open_id"
payload = b""
if card:
    try:
        card_doc = json.loads(card)
        if not isinstance(card_doc, dict) or card_doc.get("schema") != "2.0":
            raise ValueError("invalid schema")
        content = json.dumps(card_doc, ensure_ascii=False, separators=(",", ":"))
        payload = json.dumps({"receive_id": receive_id, "msg_type": "interactive", "content": content},
                             ensure_ascii=False, separators=(",", ":")).encode()
        if len(payload) > 30 * 1024:
            payload = b""
    except (TypeError, ValueError, json.JSONDecodeError):
        payload = b""
if not payload:
    payload = json.dumps({"receive_id": receive_id, "msg_type": "text",
                          "content": json.dumps({"text": text}, ensure_ascii=False)},
                         ensure_ascii=False, separators=(",", ":")).encode()
for attempt in range(3):
    delay = 1
    req = urllib.request.Request(url, data=payload, headers={"Authorization": "Bearer " + token, "Content-Type": "application/json; charset=utf-8"}, method="POST")
    try:
        with urllib.request.urlopen(req, timeout=30) as response:
            body = response.read(1048577)
        if len(body) > 1048576:
            raise ValueError("response too large")
        data = json.loads(body)
        if data.get("code") == 0:
            sys.exit(0)
        print(f"Feishu message failed: code={data.get('"'"'code'"'"')}", file=sys.stderr)
        sys.exit(1)
    except urllib.error.HTTPError as exc:
        if exc.code not in (429, 500, 502, 503, 504):
            print(f"Feishu message HTTP {exc.code}", file=sys.stderr)
            sys.exit(1)
        delay = retry_delay(exc.headers)
    except Exception:
        if attempt == 2:
            print("Feishu message request failed", file=sys.stderr)
            sys.exit(1)
    if attempt < 2:
        time.sleep(delay)
sys.exit(1)
'
}

